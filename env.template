# ============================================================
# NLtoDAX — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp env.template .env
#
# NEVER commit the .env file — it contains secrets.
# ============================================================

# ----- Azure AD / Tenant -----
TENANT_ID=

# ----- Power BI App Registration (for OBO token exchange) -----
CLIENT_ID_POWERBI=
CLIENT_SECRET_POWERBI=

# API Scope for frontend authentication (BFF + OBO pattern)
# Frontend requests token with this scope (audience = backend API)
# Backend then uses OBO to exchange for Power BI token
# IMPORTANT: You must expose this scope in your App Registration under "Expose an API"
API_SCOPE=api://<CLIENT_ID_POWERBI>/access_as_user
REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=<generate-a-random-base64-string>

# ----- Schema Extraction Service Principal -----
# Can be the same as Power BI app or a separate SP with XMLA read access
CLIENT_ID_POWERBI_SCHEMA_EXTRACTION=
CLIENT_SECRET_POWERBI_SCHEMA_EXTRACTION=

# ----- Azure OpenAI Service Principal -----
CLIENT_ID_OPENAI=
CLIENT_SECRET_OPENAI=

# ----- Azure OpenAI Configuration -----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ----- LLM Provider Toggle -----
# Set to "azure" for Azure OpenAI or "compass" for Core42 Compass model
LLM_PROVIDER=azure

# ----- Compass / Core42 (when LLM_PROVIDER=compass) -----
COMPASS_API_KEY=
COMPASS_BASE_URL=https://api.core42.ai/v1
COMPASS_MODEL=gpt-5.1

# ----- Power BI Workspace / Semantic Model -----
WORKSPACE_NAME=
WORKSPACE_ID=
DATABASE_NAME=
DATASET_ID=

# ----- ADOMD.NET DLL (local schema extraction only, not needed in Docker) -----
ADOMD_DLL=